+static inline void
+ompi_mtl_ofi_loom_complete(struct fi_cq_tagged_entry *completion,
+                            struct fi_cq_err_entry *error)
+{
+    void *context = NULL != error ? error->op_context : completion->op_context;
+    ompi_mtl_ofi_request_t *request;
+    int ret, type;
+
+    if (NULL == context) {
+        if (NULL == error) {
+            return;
+        }
+        opal_output(0, "Loom CQ error without a request: %s", fi_strerror(error->err));
+        exit(1);
+    }
+    request = TO_OFI_REQ(context);
+    type = request->type;
+    ret = NULL != error ? request->error_callback(error, request)
+                        : request->event_callback(completion, request);
+    if (OMPI_SUCCESS != ret) {
+        opal_output(0, "Loom request callback failed (type %d): %d", type, ret);
+        exit(1);
+    }
+}
