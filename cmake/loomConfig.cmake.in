# CMake package configuration file for loom

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
unset(loom_NOT_FOUND_MESSAGE)

# Required dependencies
find_dependency(Threads)

# Public headers and link interfaces require a compatible libfabric.
find_dependency(PkgConfig)
include("${CMAKE_CURRENT_LIST_DIR}/LoomFindLibfabric.cmake")
loom_find_libfabric(@LOOM_LIBFABRIC_MIN_VERSION@ @LOOM_LIBFABRIC_STATIC@)
if(NOT LOOM_LIBFABRIC_FOUND)
    set(loom_FOUND FALSE)
    set(loom_NOT_FOUND_MESSAGE "${LOOM_LIBFABRIC_ERROR}")
    return()
endif()

# The core export never depends on an optional execution frontend.
include("${CMAKE_CURRENT_LIST_DIR}/loomTargets.cmake")
set(loom_FOUND TRUE)
set(loom_core_FOUND TRUE)

# Preserve automatic frontend discovery for callers without components, but
# missing optional packages must not prevent using loom::loom. Explicit
# components limit discovery and make required frontend failures diagnosable.
set(_loom_components "${loom_FIND_COMPONENTS}")
if(NOT _loom_components)
    set(_loom_components core execution asio)
endif()
foreach(_loom_component IN LISTS _loom_components)
    if(_loom_component STREQUAL "core")
        continue()
    elseif(_loom_component STREQUAL "execution")
        set(loom_execution_FOUND FALSE)
        set(_loom_component_error "loom::execution was not built in this installation")
        if(TARGET loom::execution)
            set(loom_execution_FOUND TRUE)
        elseif(@LOOM_EXECUTION_BACKEND_COUNT@ EQUAL 1)
            set(_loom_execution_ready TRUE)
            if(@LOOM_HAS_STDEXEC@)
                if(NOT TARGET "@LOOM_STDEXEC_TARGET@")
                    find_package(stdexec CONFIG QUIET)
                endif()
                if(NOT TARGET "@LOOM_STDEXEC_TARGET@")
                    set(_loom_execution_ready FALSE)
                    set(_loom_component_error "loom::execution requires stdexec")
                endif()
            elseif(@LOOM_HAS_BEMAN_EXECUTION@)
                if(NOT TARGET beman::execution)
                    find_package(beman.execution CONFIG QUIET)
                endif()
                if(NOT TARGET beman::execution)
                    set(_loom_execution_ready FALSE)
                    set(_loom_component_error "loom::execution requires beman.execution")
                endif()
            endif()
            if(_loom_execution_ready)
                include("${CMAKE_CURRENT_LIST_DIR}/loomExecutionTargets.cmake")
                set(loom_execution_FOUND TRUE)
            endif()
        endif()
    elseif(_loom_component STREQUAL "asio")
        set(loom_asio_FOUND FALSE)
        set(_loom_component_error "loom::asio was not built in this installation")
        if(TARGET loom::asio)
            set(loom_asio_FOUND TRUE)
        elseif(@LOOM_HAS_ASIO@)
            if(NOT TARGET asio::asio AND NOT CMAKE_DISABLE_FIND_PACKAGE_asio)
                find_package(asio QUIET)
                if(NOT TARGET asio::asio)
                    pkg_check_modules(LOOM_ASIO QUIET IMPORTED_TARGET asio)
                    if(LOOM_ASIO_FOUND)
                        add_library(asio::asio INTERFACE IMPORTED)
                        set_target_properties(asio::asio PROPERTIES
                            INTERFACE_LINK_LIBRARIES PkgConfig::LOOM_ASIO)
                    endif()
                endif()
            endif()
            if(TARGET asio::asio)
                include("${CMAKE_CURRENT_LIST_DIR}/loomAsioTargets.cmake")
                set(loom_asio_FOUND TRUE)
            else()
                set(_loom_component_error "loom::asio requires Asio")
            endif()
        endif()
    else()
        set(loom_${_loom_component}_FOUND FALSE)
        set(_loom_component_error "Unknown loom component: ${_loom_component}")
    endif()
    if(loom_FIND_REQUIRED_${_loom_component} AND NOT loom_${_loom_component}_FOUND)
        string(APPEND loom_NOT_FOUND_MESSAGE "${_loom_component_error}. ")
    endif()
endforeach()
unset(_loom_components)
unset(_loom_component)
unset(_loom_component_error)
unset(_loom_execution_ready)

# Provide helpful message about available targets
if(NOT loom_FIND_QUIETLY)
    message(STATUS "Found loom: ${CMAKE_CURRENT_LIST_DIR}")
    message(STATUS "  loom::loom - Core library")
    if(TARGET loom::execution)
        message(STATUS "  loom::execution - stdexec/beman::execution integration")
    endif()
    if(TARGET loom::asio)
        message(STATUS "  loom::asio - Asio integration")
    endif()
endif()

check_required_components(loom)
