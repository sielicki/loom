# CMake package configuration file for loom

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Required dependencies
find_dependency(Threads)

# Optional: Check for libfabric
find_package(PkgConfig QUIET)
if(PKG_CONFIG_FOUND)
    pkg_check_modules(LIBFABRIC QUIET IMPORTED_TARGET libfabric)
endif()

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/loomTargets.cmake")

# Provide helpful message about available targets
if(NOT loom_FIND_QUIETLY)
    message(STATUS "Found loom: ${CMAKE_CURRENT_LIST_DIR}")
    message(STATUS "  loom::loom - Core library")
    if(TARGET loom::execution)
        message(STATUS "  loom::execution - stdexec/beman::execution integration")
    endif()
    if(TARGET loom::asio)
        message(STATUS "  loom::asio - Asio integration")
    endif()
endif()

check_required_components(loom)
